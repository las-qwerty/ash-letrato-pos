    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDMDVERDZCRkJGMkE1RDgKUldUWXBmTDdhOTBGTENDb3JwM2dMdC9rY3crUmdFZXMvbUNHaHZ4d1JUWEJJSXpLckZUSGVyTlIK",
      "endpoints": [
        "https://github.com/las-qwerty/ash-letrato-pos/releases/download/desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
