{
  "name": "simmy-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Simmy POS — point of sale monorepo (web, desktop, mobile)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @simmy/web",
    "build": "npm run build -w @simmy/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
